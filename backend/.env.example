# Copie para .env e ajuste os valores.

# Conexão assíncrona com o PostgreSQL (driver asyncpg)
DATABASE_URL=postgresql+asyncpg://estoque:estoque123@localhost:5432/estoque_saas

# Ambiente: development | production
ENVIRONMENT=development

# CORS - origem do frontend
FRONTEND_ORIGIN=http://localhost:3000

# Z-API (valores padrão/fallback; cada Tenant pode ter os seus no banco)
ZAPI_BASE_URL=https://api.z-api.io
ZAPI_CLIENT_TOKEN=seu-client-token-de-seguranca
